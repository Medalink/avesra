# Separate candidate environment: Qwen pins Transformers and Accelerate.
FROM vllm/vllm-openai@sha256:fc120ece0a388cc0aa1caad4a9f1cd92113484ab7ec2fd0efadd62585be05bf8
COPY tts.requirements.txt /opt/tts.requirements.txt
RUN python3 -m pip install --no-deps --no-cache-dir -r /opt/tts.requirements.txt \
    && python3 -m pip freeze > /opt/avesra-audio-runtime.txt
WORKDIR /opt/avesra-audio
COPY avesra_audio ./avesra_audio
ENV HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 TOKENIZERS_PARALLELISM=false OMP_NUM_THREADS=2
ENTRYPOINT ["python3", "-m", "avesra_audio.service"]
